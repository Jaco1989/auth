generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserRole {
  USER
  SKIPPER
  DRIVER
  ADMIN
  MONITOR
}

model User {
  id           String    @id
  username     String    @unique
  displayName  String
  email        String?   @unique
  passwordHash String?
  googleId     String?   @unique
  avatarUrl    String?
  bio          String?
  role         UserRole  @default(USER)
  sessions     Session[]
  permits      Permit[]
  cacthes      Catch[]

  createdAt DateTime @default(now())

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Skipper Model => 1.PERMIT 
model Permit {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  type        String
  location    String
  description String
  companyName String
  limit       Int    @default(100)

  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permits")
}

// Skipper Model => 1.CATCH
model Catch {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  port           String
  logDate        DateTime
  catchType      String
  quantity       Int
  weight         Int
  country        String
  skipperName    String
  permitHolder   String
  idNumber       String
  permitType     String
  permitDate     DateTime
  vesselName     String
  factoryName    String
  factoryAddress String

  limit Int @default(100)

  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("catches")
}
